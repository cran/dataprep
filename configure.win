#!/bin/sh
# Windows build script. Probes the compiler for the same optimisation
# flags that src/configure uses on Unix, then writes the accepted
# subset into src/Makevars.win via the src/Makevars.win.in template.
# This keeps the Unix and Windows builds on the same optimisation
# footing, while staying tolerant of toolchains that reject individual
# flags. Everything else on the compile line is left to R's defaults.
CXX=$(${R_HOME}/bin/R CMD config CXX)
CXXFLAGS=$(${R_HOME}/bin/R CMD config CXXFLAGS)

test_flag() {
  echo 'int main(){return 0;}' > conftest.cpp
  if $CXX $CXXFLAGS $1 conftest.cpp -o conftest >/dev/null 2>&1; then
    rm -f conftest conftest.exe conftest.cpp; return 0
  fi
  rm -f conftest conftest.exe conftest.cpp; return 1
}

SAFE_OPTFLAGS=""
for opt in -O3 -funroll-loops -ftree-vectorize; do
  if test_flag "$opt"; then SAFE_OPTFLAGS="$SAFE_OPTFLAGS $opt"; fi
done

sed "s|@SAFE_OPTFLAGS@|$SAFE_OPTFLAGS|g" src/Makevars.win.in > src/Makevars.win
